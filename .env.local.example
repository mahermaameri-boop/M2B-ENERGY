# Variables d'environnement M2B ENERGY
# Copiez ce fichier en .env.local et renseignez les valeurs depuis votre projet Supabase.
# (Supabase > bouton "Connect", ou Project Settings > Data API / API Keys)

# URL du projet Supabase (ex. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique côté navigateur (protégée par la RLS).
# Renseignez L'UNE des deux (selon le nom donné par Supabase) :
#   - ancien format : clé "anon" "public"   (eyJ...)
#   - nouveau format : clé "publishable"     (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRÈTE côté serveur (admin des comptes / invitations). Ne jamais exposer.
# Optionnelle au premier déploiement (le module "Rôles & accès" se désactive
# proprement si elle est absente). Renseignez L'UNE des deux :
#   - ancien format : clé "service_role" "secret"  (eyJ...)
#   - nouveau format : clé "secret"                (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
