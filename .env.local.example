# Variables d'environnement M2B ENERGY
# Copiez ce fichier en .env.local et renseignez les valeurs depuis votre projet Supabase
# (Supabase > Project Settings > API)

# URL du projet Supabase (ex. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon public" (utilisée côté navigateur, protégée par les policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (SECRETE — utilisée uniquement côté serveur pour l'admin
# des comptes et le seed). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=
